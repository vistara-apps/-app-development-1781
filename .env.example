# FlashTrade Sim Environment Variables
# Copy this file to .env and fill in your API keys

# Neynar API for Farcaster integration
VITE_NEYNAR_API_KEY=your_neynar_api_key_here

# Base RPC URL for blockchain data
VITE_BASE_RPC_URL=https://mainnet.base.org

# Airstack API for on-chain data
VITE_AIRSTACK_API_KEY=your_airstack_api_key_here

# App Configuration
VITE_APP_NAME=FlashTrade Sim
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_REAL_AUTH=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ADVANCED_TRADING=true

# Demo Mode Settings
VITE_DEMO_MODE=true
VITE_STARTING_BALANCE=10000
